ARG SEED_PYTHON_BASE=python:3.12-slim
FROM ${SEED_PYTHON_BASE}

ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY app/ app/
COPY migrations/20261128_recovery_control.sql migrations/20261128_recovery_control.sql
RUN test -f app/public_main.py && test -f app/services/feedback_delivery.py \
    && test -f app/readiness.py \
    && test -f app/api/errors.py && test -f app/api/input_boundary.py \
    && test -f migrations/20261128_recovery_control.sql

USER 65532:65532
CMD ["python", "-m", "uvicorn", "app.public_main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
