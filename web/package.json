{
  "name": "careerpilot-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "CareerPilot 前端（依据 Figma 设计稿重写）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:bank": "node scripts/build-bank.mjs",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check src",
    "format": "prettier --write src",
    "knip": "knip"
  },
  "knip": {
    "entry": ["src/main.tsx", "scripts/build-bank.mjs", "tests/register.mjs", "tests/*.test.mjs"],
    "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.mjs"]
  },
  "dependencies": {
    "katex": "^0.16.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.48.0",
    "prettier": "^3.10.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11"
  }
}
