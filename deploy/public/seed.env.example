# Copy to /etc/careerpilot-seed/runtime.conf and make it mode 0600.
SEED_RELEASE_TAG=
SEED_HOST=app.agent-interview.icu
SEED_PUBLIC_ORIGIN=https://app.agent-interview.icu
SEED_DB_NAME=careerpilot_seed
SEED_DB_ADMIN_PASSWORD=
SEED_DB_PASSWORD=
SEED_SESSION_SECRET=
SEED_MODEL_BASE_URL=
SEED_MODEL_KEY=
SEED_MODEL_NAME=
SEED_INPUT_CNY_PER_MILLION=
SEED_OUTPUT_CNY_PER_MILLION=
SEED_MONTHLY_CNY=50
SEED_DAILY_USER_CNY=
SEED_STORAGE_REGION=
SEED_MODEL_PROVIDER_LABEL=
