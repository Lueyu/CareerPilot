# ===== CareerPilot 环境变量示例 =====
# 仅变量清单，不能复制后直接启动。先用 server/personal_credentials.py init 生成
# personal/runtime/personal.env，再显式 docker compose --env-file personal/runtime/personal.env ...
# 原生启动使用 deploy/start-personal.ps1 -EnvFile <绝对路径>；保留已有个人 .env。

# --- 核心 ---
WEB_HOST_PORT=127.0.0.1:5173
API_HOST_PORT=127.0.0.1:8000
PG_HOST_PORT=127.0.0.1:5432
# PostgreSQL 连接串(仅本地裸跑需要改; docker compose 内部自动注入)
DATABASE_URL=
POSTGRES_PASSWORD=
# 个人工作空间的本地 API 令牌
API_TOKEN=
CAREERPILOT_SECRETS_KEY=
# 首次启动自动创建的工作空间标识
DEFAULT_WORKSPACE_SLUG=personal
# API request quotas, deployment-side JSON. Daily caps reset at UTC+8 midnight.
# Every generation-capable route also consumes llm quota. Config changes retain today's counters.
# API_RATE_LIMITS={"read":{"burst":120,"per_minute":600,"daily":20000},"write":{"burst":30,"per_minute":120,"daily":3000},"llm":{"burst":5,"per_minute":10,"daily":300}}

# --- LLM(可选) ---
# 浏览题库和已评阅答卷可留空；使用 AI 对话时填入可用的模型配置
# 支持 OpenAI 兼容接口(DeepSeek / GLM / 火山方舟网关等)
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# JSON exact origins, deployment only. Empty keeps public HTTPS only.
# For a local model: ["http://127.0.0.1:11434"] (no path).
MODEL_LOCAL_ORIGINS=[]

# --- 公开内容发布(可选) ---
# GitHub Personal Access Token(需要 repo 权限; 用于把审核后的内容发布到公开门户仓库)
GITHUB_TOKEN=
PORTAL_TARGET_REPO=Lueyu/CareerPilot
PORTAL_BASE_BRANCH=master
PORTAL_CONTENT_DIR=portal/content
# 低风险内容自动合并 PR(高风险始终人工审核)
PORTAL_AUTO_MERGE=false

# Optional product feedback. Configure on the API host (docs/product-feedback.md).
FEEDBACK_TO=
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=
FEEDBACK_SMTP_TLS=ssl
FEEDBACK_SMTP_USERNAME=
FEEDBACK_SMTP_PASSWORD=
FEEDBACK_SMTP_FROM=
FEEDBACK_REVIEW_BASE_URL=
FEEDBACK_REVIEW_MODEL=
FEEDBACK_REVIEW_API_KEY=
