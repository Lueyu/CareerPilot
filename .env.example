# ===== CareerPilot 环境变量示例 =====
# 用法: cp .env.example .env  然后按需修改
# docker compose 会自动读取本文件; 本地裸跑时 server/.env 也使用相同变量名

# --- 核心 ---
WEB_HOST_PORT=127.0.0.1:5173
API_HOST_PORT=127.0.0.1:8000
PG_HOST_PORT=127.0.0.1:5432
# PostgreSQL 连接串(仅本地裸跑需要改; docker compose 内部自动注入)
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot_dev@localhost:5432/careerpilot
# 个人工作空间的本地 API 令牌
API_TOKEN=cp-dev-token
# 首次启动自动创建的工作空间标识
DEFAULT_WORKSPACE_SLUG=personal

# --- LLM(可选) ---
# 浏览题库和已评阅答卷可留空；使用 AI 对话时填入可用的模型配置
# 支持 OpenAI 兼容接口(DeepSeek / GLM / 火山方舟网关等)
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- 公开内容发布(可选) ---
# GitHub Personal Access Token(需要 repo 权限; 用于把审核后的内容发布到公开门户仓库)
GITHUB_TOKEN=
PORTAL_TARGET_REPO=Lueyu/CareerPilot
PORTAL_BASE_BRANCH=master
PORTAL_CONTENT_DIR=portal/content
# 低风险内容自动合并 PR(高风险始终人工审核)
PORTAL_AUTO_MERGE=false
